# Supabase Project URL (found in Project Settings -> API)
SUPABASE_URL=

# Supabase Service Role Key (found in Project Settings -> API) 
# WARNING: Keep this secret! This bypasses RLS.
# NOTE: The key MUST be a valid JWT starting with 'eyJ'. 
# Do NOT use a Personal Access Token (which starts with 'sb_secret_').
SUPABASE_SERVICE_ROLE_KEY=

# Local or remote path to the finalized PyTorch model checkpoint
MODEL_PATH=../models/exported/omni_fusion_final.pt

# Allowed origins for CORS (comma separated, e.g., http://localhost:3000)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3001

# Environment mode (development/production)
# NOTE: The demo seed script (scripts/seed_demo_accounts.py) will abort if this is set to 'production'
ENVIRONMENT=development
